# Copie para .env.local e preencha os valores. Não commite .env.local.

# --- App (URL pública: OG/WhatsApp, sitemap, canónico) ---
# Defina com o domínio final. Na Vercel, se omitir, usa-se automaticamente https://<VERCEL_URL>.
# NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# --- Resend (email) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Escritório <noreply@dominio.com>"
# CONTACT_TO_EMAIL=destino@dominio.com

# --- Base de dados (Postgres: Vercel Marketplace / Neon) ---
# POSTGRES_URL=  # obrigatório em .env.local para npm run db:push / db:seed

# --- Auth.js (sessão JWT; área /admin) ---
# AUTH_SECRET=  # gere com: openssl rand -base64 32
# URL completa (http:// ou https://) ou só o host (assume-se https://). Valores inválidos são ignorados
# e o Auth.js usa o host do pedido (útil na Vercel). Em local: http://localhost:3000
# AUTH_URL=http://localhost:3000
# Em produção: https://teu-projeto.vercel.app ou o domínio final

# --- Semente do primeiro administrador (só correr localmente, depois remover do .env) ---
# ADMIN_SEED_EMAIL=voce@exemplo.com
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=Nome